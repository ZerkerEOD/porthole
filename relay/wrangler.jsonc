{
  // Porthole push relay. Deploy with your own secrets (see docs/self-host-relay.md):
  //   wrangler secret put GRANT_SIGNING_KEY      Ed25519 private key, PKCS8 base64
  //   wrangler secret put FCM_SERVICE_ACCOUNT    Firebase service account JSON
  //   wrangler secret put ENTITLEMENT_SECRET     shared with your entitlement service
  // Vars: ENTITLEMENT_URL (your service) or ENTITLEMENT_STATIC_KEYS (sha256 hex
  // list of supporter keys for a personal relay).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porthole-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "relay.zerkersec.io", "custom_domain": true }],
  "vars": {
    "FCM_PROJECT_ID": "",
    "ANDROID_PACKAGE": "io.zerkersec.porthole",
    "ATTEST_MODE": "off",
    "ENTITLEMENT_URL": "https://zerkersec.io/api/entitlement",
    "ENTITLEMENT_STATIC_KEYS": ""
  },
  "kv_namespaces": [
    { "binding": "DENY", "id": "d9d6afcc9480447da4588c3ede41d122" }
  ],
  "unsafe": {
    "bindings": [
      { "name": "PUSH_RATE", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
      { "name": "GRANT_RATE", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
    ]
  },
  "observability": { "enabled": true }
}
