#!/usr/bin/env bash
# Refuses a commit whose staged content looks like key material. Enabled with:
#   git config core.hooksPath scripts/git-hooks
set -euo pipefail
bad=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in *.png|*.jpg|*.jpeg|*.webp|*.ico|*.ttf|*.otf|scripts/git-hooks/*) continue ;; esac
  # A PEM header counts only when a base64 body follows it (code that merely prints the
  # header, such as a test that generates keys at run time, is fine).
  if git show ":$f" | grep -Pzq -- '-----BEGIN (RSA |EC |OPENSSH |ENCRYPTED )?PRIVATE KEY-----\n[A-Za-z0-9+/=]{40,}' \
     || git show ":$f" | grep -qE -- '"type": *"service_account"|"private_key_id"|AIza[0-9A-Za-z_-]{35}|eyJhbGciOi'; then
    echo "pre-commit: $f contains key material; unstage it (git restore --staged '$f')" >&2; bad=1
  fi
  case "$f" in
    *.p8|*.p12|*.jks|*.keystore|*.mobileprovision|*AuthKey_*|*google-services.json|*GoogleService-Info.plist|*key.properties)
      echo "pre-commit: $f is signing material; it must not be committed" >&2; bad=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
exit $bad
