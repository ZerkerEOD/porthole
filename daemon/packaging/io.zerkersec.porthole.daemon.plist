<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent: ~/Library/LaunchAgents/io.zerkersec.porthole.daemon.plist
     Load with: launchctl load -w ~/Library/LaunchAgents/io.zerkersec.porthole.daemon.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.zerkersec.porthole.daemon</string>
  <key>ProgramArguments</key>
  <array><string>/usr/local/bin/porthole</string><string>serve</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>/tmp/porthole.log</string>
  <key>StandardErrorPath</key><string>/tmp/porthole.log</string>
</dict>
</plist>
